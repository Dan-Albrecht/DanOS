{
    // Don't want the test target running because that thinks it gets to define the panic handler
    "rust-analyzer.check.allTargets": false,
    "rust-analyzer.showUnlinkedFileNotification": false,
    // This is already in our config.toml, but this thing doesn't pick it up and we have to also set it here
    "rust-analyzer.cargo.extraEnv": {
        "CARGO_UNSTABLE_JSON_TARGET_SPEC": "true"
    },
    "files.exclude": {
        "target": true,
    },
    "search.exclude": {
        "target": true,
    }
}